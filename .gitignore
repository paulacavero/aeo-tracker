.env
data/
auth/
__pycache__/
*.pyc
.DS_Store

# Private config — your real prompts and competitor strategy stay local.
# Example versions (config/*.example.json) ARE committed so others can use the tool.
config/prompts.json
config/settings.json
# Backups of the two files above — same private contents.
config/*.bak
config/*.bak[0-9]

# Generated dashboards (regenerated from the DBs; can contain competitor intel)
dashboard.html
dashboard_browser.html

# Research notes (competitor analysis) — keep local unless you choose to publish
research/

# Runtime logs — contain prompt texts and brand results (your private strategy)
logs/

# Wrangler's local cache — holds your Cloudflare account ID
.wrangler/
